NEXT_PUBLIC_BSC_TESTNET_RPC_URL="https://data-seed-prebsc-1-s1.binance.org:8545/"
BSC_MAINNET_RPC="https://bsc-dataseed.binance.org/"
BSC_TESTNET_RPC="https://data-seed-prebsc-1-s1.binance.org:8545/"

# Testnet deployments are optional; mainnet deployments are configured in src/config/contracts.ts
NEXT_PUBLIC_TESTNET_NFT_ADDRESS=""
NEXT_PUBLIC_TESTNET_STAKING_ADDRESS=""
NEXT_PUBLIC_TESTNET_REGISTRY_ADDRESS=""

# Hardhat deployment credentials. Never commit real values.
PRIVATE_KEY=""
BSCSCAN_API_KEY=""
NEXT_PUBLIC_TESTNET_CHAINLINK_BNB_USD="0x2514895c78B50853799fB792454453076C104B06"
NEXT_PUBLIC_MAINNET_CHAINLINK_BNB_USD="0x0567F2323251f0Aab15c8dFb1967E4e8A7D42aeE"

# Keep the server and public admin allowlists aligned
ADMIN_WALLETS=""
NEXT_PUBLIC_ADMIN_WALLETS=""
ADMIN_SESSION_SECRET=""

# RainbowKit / WalletConnect public project ID
