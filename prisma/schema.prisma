// Prisma schema for Agent Legends 2.0
// Off-chain analytics, cryptographic spin audit logs, manual USDT payout pipeline, and referral tracking.

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "windows"]
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  walletAddress       String   @id
  referrerAddress     String?
  totalMints          Int      @default(0)
  totalStaked         Int      @default(0)
  availableSpins      Int      @default(0)
  totalSpins          Int      @default(0)
  successfulReferrals Int      @default(0)
  referredNftCount    Int      @default(0)
  claimedFreeNfts     Int      @default(0)
  totalRewardsWonUsdt Float    @default(0.0)
  pendingPayoutUsdt   Float    @default(0.0)
  paidPayoutUsdt      Float    @default(0.0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  spins        Spin[]
  payouts      Payout[]
  rewardClaims RewardClaim[]
  bonusEntries BonusSelectionEntry[]
  transactions Transaction[]

  @@index([referrerAddress])
}

model Spin {
  id                String   @id @default(cuid())
  spinId            String   @unique // e.g. SPIN-1718293-A8F2
  requestId         String   @unique
  walletAddress     String
  outcome           String // TRY_NEXT_TIME, USD_0_05, USD_0_10, USD_0_40, USD_0_50, USD_0_60, USD_0_70, USD_1_00
  rewardAmountUsdt  Float    @default(0.0)
  isFreeSpinAwarded Boolean  @default(false)
  randomNumber      Int // 0 - 9999 generated cryptographically
  isWinner          Boolean  @default(false)
  payoutStatus      String   @default("NONE") // NONE, PENDING, PROCESSING, PAID, REJECTED
  nftTokenId        String?
  createdAt         DateTime @default(now())

  user        User         @relation(fields: [walletAddress], references: [walletAddress])
  payout      Payout?
  rewardClaim RewardClaim?

  @@index([walletAddress])
  @@index([payoutStatus])
  @@index([createdAt])
}

model Payout {
  id               String    @id @default(cuid())
  spinId           String    @unique
  claimId          String?   @unique
  walletAddress    String
  rewardAmountUsdt Float
  status           String    @default("PENDING") // PENDING, PROCESSING, PAID, REJECTED
  txHash           String?   @unique // A transaction can settle at most one payout
  verifiedAt       DateTime?
  adminNote        String?
  rejectionReason  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user        User         @relation(fields: [walletAddress], references: [walletAddress])
  spin        Spin         @relation(fields: [spinId], references: [spinId])
  rewardClaim RewardClaim? @relation(fields: [claimId], references: [id])

  @@index([walletAddress])
  @@index([status])
  @@index([txHash])
}

model RewardConfiguration {
  outcome          String   @id
  label            String
  rewardAmountUsdt Float
  preMilestoneBps  Int      @default(0)
  postMilestoneBps Int      @default(0)
  enabled          Boolean  @default(true)
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
}

model RewardMilestone {
  id                String    @id @default("REWARD_MILESTONE")
  milestoneReached  Boolean   @default(false)
  verifiedMintCount Int       @default(0)
  reachedAt         DateTime?
  updatedAt         DateTime  @updatedAt
  createdAt         DateTime  @default(now())
}

model RewardClaim {
  id               String    @id @default(cuid())
  claimId          String    @unique
  spinId           String    @unique
  walletAddress    String
  nftTokenId       String?
  outcome          String
  rewardAmountUsdt Float?
  twitterUrl       String
  publicConfirmed  Boolean   @default(false)
  additionalInfo   String?
  status           String    @default("SUBMITTED")
  isBonus          Boolean   @default(false)
  selectedAt       DateTime?
  selectedBatchId  String?
  adminNote        String?
  rejectionReason  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user           User                 @relation(fields: [walletAddress], references: [walletAddress])
  spin           Spin                 @relation(fields: [spinId], references: [spinId])
  payout         Payout?
  bonusEntry     BonusSelectionEntry?
  reviews        RewardReview[]
  selectionBatch BonusSelectionBatch? @relation(fields: [selectedBatchId], references: [id])

  @@index([walletAddress])
  @@index([status])
  @@index([isBonus])
  @@index([createdAt])
}

model RewardReview {
  id          String   @id @default(cuid())
  claimId     String
  adminWallet String
  action      String
  note        String?
  createdAt   DateTime @default(now())

  claim RewardClaim @relation(fields: [claimId], references: [id])

  @@index([claimId])
  @@index([createdAt])
}

model BonusPool {
  id                 String   @id @default("BONUS_POOL")
  budgetUsdt         Float    @default(0.0)
  remainingUsdt      Float    @default(0.0)
  minimumAmountUsdt  Float    @default(0.05)
  maximumAmountUsdt  Float    @default(1.0)
  maximumSelections  Int      @default(10)
  selectionFrequency String   @default("MANUAL")
  selectionStatus    String   @default("ACTIVE")
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())
}

model BonusSelectionBatch {
  id                String   @id @default(cuid())
  batchId           String   @unique
  selectedCount     Int      @default(0)
  unselectedCount   Int      @default(0)
  allocatedUsdt     Float    @default(0.0)
  remainingPoolUsdt Float    @default(0.0)
  createdBy         String
  createdAt         DateTime @default(now())

  entries        BonusSelectionEntry[]
  selectedClaims RewardClaim[]
}

model BonusSelectionEntry {
  id               String   @id @default(cuid())
  batchId          String
  claimId          String   @unique
  walletAddress    String
  selected         Boolean  @default(false)
  rewardAmountUsdt Float?
  createdAt        DateTime @default(now())

  batch BonusSelectionBatch @relation(fields: [batchId], references: [id])
  claim RewardClaim         @relation(fields: [claimId], references: [id])
  user  User                @relation(fields: [walletAddress], references: [walletAddress])

  @@unique([batchId, claimId])
  @@index([walletAddress])
  @@index([selected])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminWallet String
  action      String // e.g. "VERIFY_PAYOUT", "REJECT_PAYOUT", "EXPORT_REPORT"
  targetId    String?
  details     String // JSON metadata
  createdAt   DateTime @default(now())

  @@index([adminWallet])
  @@index([action])
  @@index([createdAt])
}

model Transaction {
  id            String   @id @default(cuid())
  txHash        String   @unique
  walletAddress String
  type          String // MINT, STAKE, UNSTAKE, CLAIM_REFERRAL_NFT, USDT_PAYOUT
  amount        String?
  status        String   @default("CONFIRMED")
  metadata      String? // JSON metadata
  createdAt     DateTime @default(now())

  user User @relation(fields: [walletAddress], references: [walletAddress])

  @@index([walletAddress])
  @@index([type])
}
